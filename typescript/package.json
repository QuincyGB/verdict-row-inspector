{
  "author": "Ren, Verdict Row Patrol <patrol@verdictrow.com>",
  "bugs": {
    "url": "https://github.com/QuincyGB/verdict-row-inspector/issues"
  },
  "contributors": [
    {
      "email": "patrol@verdictrow.com",
      "name": "Ren, Verdict Row Patrol"
    }
  ],
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0"
  },
  "description": "Inspector SDK for the Verdict Row x402 fleet: a TypeScript client for StallRow's inspector surface (Recheck, Sign Reader, Score Book, Guard, Inspector Physical, packs, Fleet Pass, the hash-chained change feed, watches and signed webhooks) and RouteVerdict, with x402 payment handling and a per-route spend guard built in.",
  "devDependencies": {
    "@langchain/core": "^1.3.4",
    "@types/node": "^18.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.2.2",
    "viem": "^2.21.0",
    "vitest": "^2.1.9",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.mjs",
      "require": "./dist/langchain.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "homepage": "https://github.com/QuincyGB/verdict-row-inspector",
  "keywords": [
    "x402",
    "agents",
    "payments",
    "usdc",
    "base",
    "inspector",
    "verdict-row",
    "stall-row",
    "langchain"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "name": "@quincygb/verdict-row-inspector",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuincyGB/verdict-row-inspector.git"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "version": "0.3.0",
  "peerDependencies": {
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
